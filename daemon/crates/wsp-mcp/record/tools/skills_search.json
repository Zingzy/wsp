{
  "cloudOff": {
    "name": "skills_search",
    "description": "Skills on skills.sh whose words match the query, most installed first as skills.sh ranks them: each one's name, the repo it comes from, how many times it was installed, and the id skills_add takes. The host asks skills.sh; an empty query is refused.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "the words to search skills.sh for"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "how many to answer, 20 without it"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "skillId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "installs": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "id",
              "source",
              "skillId",
              "name",
              "installs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "skills"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
