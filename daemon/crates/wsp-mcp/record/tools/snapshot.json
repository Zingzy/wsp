{
  "cloudOff": null,
  "cloudOn": {
    "name": "snapshot",
    "description": "A project image of the workspace: its image version plus the project loaded on it as its disk stands now, synced first so a file written just before is whole on the image, ready for new with from. Only a running machine with a project imported, on a provider that copies a machine's disk, can be snapshotted, and which life the copy may come from is that provider's rule: a machine that was never resumed on the cloud, any life on a container fork. Anything else, and a disk whose sync fails, is refused in one line and nothing is taken.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "workspace": {
          "type": "string",
          "description": "the workspace's name, or its id when two share a name"
        }
      },
      "required": [
        "workspace"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "projectGolden": {
          "type": "object",
          "properties": {
            "snapshotId": {
              "type": "string"
            },
            "projects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "dest": {
                    "type": "string"
                  },
                  "importedAt": {
                    "type": "string"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "name",
                  "dest",
                  "importedAt"
                ],
                "additionalProperties": false
              }
            },
            "golden": {
              "type": "string"
            },
            "version": {
              "type": "integer"
            },
            "workspaceId": {
              "type": "string"
            },
            "workspaceName": {
              "type": "string"
            },
            "createdAt": {
              "type": "string"
            },
            "place": {
              "type": "string"
            }
          },
          "required": [
            "snapshotId",
            "projects",
            "golden",
            "workspaceId",
            "workspaceName",
            "createdAt"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "projectGolden"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "anthropic/alwaysLoad": false
    }
  }
}
