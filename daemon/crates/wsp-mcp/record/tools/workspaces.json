{
  "name": "workspaces",
  "description": "Every workspace this host runs, as the app lists them: id, name, the project it holds, the computer it runs on and its state as the sidebar shows it (running, paused, waking or unreachable, off the phase with the provider's word for the machine and the daemon reach beside it) where the kind has one. A workspace is a copy of its project's computer with the project inside, made for one piece of work and named by it; on the computer the app runs on it is a copy of the project's folder beside it. The name is what run and every other verb take.",
  "inputSchema": {
    "type": "object",
    "properties": {},
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "workspaces": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "machineId": {
              "type": "string"
            },
            "phase": {
              "type": "string",
              "enum": [
                "running",
                "pausing",
                "napping",
                "waking",
                "gone"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "cloud",
                "local",
                "ssh"
              ]
            },
            "golden": {
              "type": "string"
            },
            "createdAt": {
              "type": "string"
            },
            "project": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "computer": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "path",
                "computer"
              ],
              "additionalProperties": false
            },
            "folder": {
              "type": "string"
            },
            "home": {
              "type": "string"
            },
            "claudeSessionId": {
              "type": "string"
            },
            "gone": {
              "type": "string"
            },
            "theme": {
              "type": "object",
              "properties": {
                "dots": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "angle": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 360
                      },
                      "radius": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "angle",
                      "radius"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 3
                },
                "harmony": {
                  "type": "string",
                  "enum": [
                    "single",
                    "complementary",
                    "analogous",
                    "splitComplementary",
                    "triadic",
                    "analogousThree"
                  ]
                },
                "grain": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 1
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "auto",
                    "light",
                    "dark"
                  ]
                }
              },
              "required": [
                "dots",
                "harmony",
                "grain",
                "opacity",
                "mode"
              ],
              "additionalProperties": false
            },
            "glyph": {
              "type": "string",
              "enum": [
                "terminal",
                "code",
                "bug",
                "wrench",
                "hammer",
                "rocket",
                "flask",
                "database",
                "cloud",
                "globe",
                "compass",
                "map",
                "book",
                "feather",
                "palette",
                "leaf",
                "star",
                "bolt",
                "key",
                "shield",
                "box",
                "folder",
                "chip",
                "lamp"
              ]
            },
            "daemonNote": {
              "type": "string"
            },
            "daemonRefusedAt": {
              "type": "object",
              "properties": {
                "machineId": {
                  "type": "string"
                },
                "at": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                }
              },
              "required": [
                "machineId",
                "at",
                "why"
              ],
              "additionalProperties": false
            },
            "vaultedAt": {
              "type": "string"
            },
            "vaultRefused": {
              "type": "string"
            },
            "wakeRefused": {
              "type": "string"
            },
            "agents": {
              "type": "object",
              "properties": {
                "spawn": {
                  "type": "boolean"
                },
                "maxMachines": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxDepth": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "spawn",
                "maxMachines",
                "maxDepth"
              ],
              "additionalProperties": false
            },
            "parentThreadId": {
              "type": "string"
            },
            "rootThreadId": {
              "type": "string"
            },
            "parentWorkspaceId": {
              "type": "string"
            },
            "place": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "copy": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "base": {
                  "type": "string"
                },
                "branch": {
                  "type": "string"
                },
                "carried": {
                  "type": "string",
                  "enum": [
                    "deps-and-config",
                    "config-only",
                    "nothing"
                  ]
                },
                "fellBack": {
                  "type": "string"
                },
                "road": {
                  "type": "string",
                  "enum": [
                    "clonefile",
                    "worktree"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "base",
                "branch",
                "carried",
                "road",
                "source"
              ],
              "additionalProperties": false
            },
            "portBase": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "machineState": {
              "type": "string",
              "enum": [
                "starting",
                "running",
                "paused",
                "gone"
              ]
            },
            "size": {
              "type": "object",
              "properties": {
                "cpu": {
                  "type": "number"
                },
                "memMb": {
                  "type": "number"
                }
              },
              "required": [
                "cpu",
                "memMb"
              ],
              "additionalProperties": false
            },
            "rateUsdPerHour": {
              "type": "number"
            },
            "reason": {
              "type": "string"
            },
            "idleAt": {
              "type": "number"
            },
            "facts": {
              "type": "object",
              "properties": {
                "os": {
                  "type": "string"
                },
                "uptimeMs": {
                  "type": "number"
                },
                "folder": {
                  "type": "string"
                }
              },
              "required": [
                "os",
                "uptimeMs",
                "folder"
              ],
              "additionalProperties": false
            },
            "reach": {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "reachable",
                    "no-daemon",
                    "unreachable",
                    "napping",
                    "unsupported",
                    "gone",
                    "slow",
                    "zombie"
                  ]
                },
                "offline": {
                  "type": "boolean"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "name",
            "machineId",
            "phase",
            "golden",
            "createdAt",
            "project",
            "machineState",
            "size",
            "rateUsdPerHour",
            "reach"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "workspaces"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
