          "type": "boolean"
        },
        "values": {
          "type": "object",
          "additionalProperties": {}
        },
        "press": {
          "type": "string"
        },
        "row": {
          "type": "integer"
        },
        "action": {
          "type": "integer"
        },
        "if_version": {
          "type": "integer"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "warnings": {},
        "problems": {}
      },
      "required": [
        "version",
        "text"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
