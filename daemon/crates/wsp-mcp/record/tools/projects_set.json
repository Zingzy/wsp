            },
            "model": {
              "$ref": "#/properties/defaults/properties/agent"
            },
            "effort": {
              "$ref": "#/properties/defaults/properties/agent"
            },
            "access": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "enum": [
                    "ask",
                    "auto-edit",
                    "full",
                    "plan"
                  ]
                },
                "mode": {
                  "type": "string"
                },
                "from": {
                  "$ref": "#/properties/defaults/properties/agent/properties/from"
                }
              },
              "required": [
                "value",
