{
  "name": "servers",
  "description": "Every MCP server each agent's own config file defines on one computer or workspace, and a workspace's project files: the agent, the file, how it is reached (its command with every value hidden, or its url's host), the names of the variables it sets or reads and never their values, whether the file switches it off, whether wsp's recipe put it there on a box, and its sign-in as the config alone says it: open for a command or a fixed header, unknown for a remote server until something connects. Read as the login the computer was added with, off each agent's config and whether its files are there: no MCP server is started and no login file is opened. A napping workspace answers what stood there when it last ran, marked stale, and is not woken.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "workspace": {
        "type": "string",
        "description": "the workspace to read, by its name, or its id when two share a name; absent reads a computer"
      },
      "on": {
        "type": "string",
        "description": "the computer to read, by the name computers lists; absent with no workspace is the computer the app runs on"
      }
    },
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "target": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "placeId": {
                "type": "string"
              },
              "project": {
                "type": "string"
              }
            },
            "required": [
              "placeId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "workspaceId": {
                "type": "string"
              }
            },
            "required": [
              "workspaceId"
            ],
            "additionalProperties": false
          }
        ]
      },
      "home": {
        "type": "string"
      },
      "user": {
        "type": "string"
      },
      "readAt": {
        "type": "string"
      },
      "stale": {
        "type": "string",
        "const": "napping"
      },
      "refused": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "projects": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "path"
          ],
          "additionalProperties": false
        }
      },
      "reach": {
        "type": "string",
        "enum": [
          "here",
          "relay",
          "none"
        ]
      },
      "servers": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "scope": {
              "type": "string",
              "enum": [
                "user",
                "home",
                "project"
              ]
            },
            "file": {
              "type": "string"
            },
            "transport": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "stdio"
                    },
                    "line": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "line"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "http"
                    },
                    "host": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "host"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "envNames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "auth": {
              "type": "string",
              "enum": [
                "open",
                "env-key",
                "connected",
                "signed-in",
                "needs-sign-in",
                "failed",
                "unknown"
              ]
            },
            "enabled": {
              "type": "boolean"
            },
            "inRecipe": {
              "type": "boolean"
            },
            "tools": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "params": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string"
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "description": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "required"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            },
            "project": {
              "$ref": "#/properties/projects/items"
            }
          },
          "required": [
            "agent",
            "name",
            "scope",
            "file",
            "transport",
            "envNames",
            "auth",
            "enabled"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "target",
      "home",
      "user",
      "readAt",
      "refused",
      "servers"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
