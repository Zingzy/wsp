            ],
            "additionalProperties": false
          }
        },
        "reach": {
          "type": "string",
          "enum": [
            "here",
            "relay",
            "none"
          ]
        },
        "servers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
