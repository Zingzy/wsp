{
  "cloudOff": {
    "name": "threads",
    "description": "Every thread as the sidebar lists it: its project, the folder it works in (the project folder, or a worktree of the project's repo), that folder's branch as git reads it now, the computer it runs on, the agent inside, its state, who opened it (person, cli or agent) and its title. Optionally within one project. A thread an agent inside another thread opened carries parentThreadId and rootThreadId, which is the tree stop ends as one. subagents lists the agent's own subagents of every turn (id, title, state running, done, failed or stopped); stop takes one of them alone by its id.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "description": "one project's threads, by the name or the id projects lists"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "threads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "threadId": {
                "type": "string"
              },
              "workspaceId": {
                "type": "string"
              },
              "harness": {
                "type": "string"
              },
              "startedBy": {
                "type": "string",
                "enum": [
                  "person",
                  "cli",
                  "agent"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "running",
                  "completed",
                  "interrupted",
                  "failed"
                ]
              },
              "title": {
                "type": "string"
              },
              "sessionId": {
                "type": "string"
              },
              "claudeSessionId": {
                "type": "string"
              },
              "startedAt": {
                "type": "number"
              },
              "endedAt": {
                "type": "number"
              },
              "cwd": {
                "type": "string"
              },
              "turns": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "ran": {
                "type": "boolean"
              },
              "parentThreadId": {
                "type": "string"
              },
              "rootThreadId": {
                "type": "string"
              },
              "attempt": {
                "type": "string"
              },
              "asking": {
                "type": "string"
              },
              "waitingOn": {
                "type": "object",
                "properties": {
                  "threadId": {
                    "type": "string"
                  },
                  "workspaceId": {
                    "type": "string"
                  },
                  "sessionId": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "prompt": {
                    "type": "object",
                    "properties": {
                      "askId": {
                        "type": "string"
                      },
                      "toolName": {
                        "type": "string"
                      },
                      "toolUseId": {
                        "type": "string"
                      },
                      "parentToolUseId": {
                        "type": "string"
                      },
                      "input": {
                        "type": "string"
                      },
                      "detail": {
                        "type": "string"
                      },
                      "options": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "label": {
                              "type": "string"
                            },
                            "effect": {
                              "type": "string",
                              "enum": [
                                "allow",
                                "deny",
                                "mode",
                                "answer"
                              ]
                            },
                            "mode": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "label",
                            "effect"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "askId",
                      "toolName",
                      "input",
                      "options"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "threadId",
                  "workspaceId",
                  "sessionId",
                  "title",
                  "prompt"
                ],
                "additionalProperties": false
              },
              "setupRefusal": {
                "type": "string"
              },
              "costUsd": {
                "type": "number"
              },
              "pid": {
                "type": "integer"
              },
              "readAt": {
                "type": "number"
              },
              "settledAt": {
                "type": "number"
              },
              "pinnedAt": {
                "type": "number"
              },
              "snoozedUntil": {
                "type": "number"
              },
              "wokeAt": {
                "type": "number"
              },
              "section": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "enum": [
                      "needs-you",
                      "working",
                      "done",
                      "idle"
                    ]
                  },
                  "whileState": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "whileState"
                ],
                "additionalProperties": false
              },
              "rewoundAt": {
                "type": "number"
              },
              "permissionMode": {
                "type": "string"
              },
              "fast": {
                "type": "boolean"
              },
              "subagents": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "running",
                        "done",
                        "failed",
                        "stopped"
                      ]
                    },
                    "parentToolUseId": {
                      "type": "string"
                    },
                    "depth": {
                      "type": "integer",
                      "exclusiveMinimum": 0
                    },
                    "startedAt": {
                      "type": "number"
                    },
                    "endedAt": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "state",
                    "startedAt"
                  ],
                  "additionalProperties": false
                }
              },
              "projectName": {
                "type": "string"
              },
              "folder": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "computerName": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "workspaceId",
              "harness",
              "startedBy",
              "status",
              "title",
              "sessionId",
              "turns",
              "ran",
              "projectName",
              "folder",
              "branch",
              "computerName"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "threads"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "_meta": {
      "anthropic/alwaysLoad": false
    }
  },
