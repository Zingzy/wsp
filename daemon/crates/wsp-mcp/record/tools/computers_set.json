        "computer": {
          "type": "string",
          "description": "the computer, by the name computers lists or its id"
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "description": "how many threads may run on that computer at once"
        },
        "nap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 180,
          "description": "the minutes a quiet workspace there runs before it naps; 0 never naps it"
        },
        "reset": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "threads",
              "nap"
            ]
          },
          "description": "the settings to take back to their defaults, by the same words"
        }
      },
