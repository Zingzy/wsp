                "shield",
                "box",
                "folder",
                "chip",
                "lamp"
              ]
            },
            "daemonNote": {
              "type": "string"
            },
            "daemonRefusedAt": {
              "type": "object",
              "properties": {
                "machineId": {
                  "type": "string"
                },
                "at": {
                  "type": "string"
                },
                "why": {
                  "type": "string"
                }
              },
              "required": [
                "machineId",
                "at",
                "why"
              ],
              "additionalProperties": false
            },
            "vaultedAt": {
              "type": "string"
            },
            "vaultRefused": {
              "type": "string"
            },
            "wakeRefused": {
              "type": "string"
            },
            "agents": {
              "type": "object",
              "properties": {
                "spawn": {
                  "type": "boolean"
                },
                "maxMachines": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxDepth": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "spawn",
                "maxMachines",
                "maxDepth"
              ],
              "additionalProperties": false
            },
            "parentThreadId": {
              "type": "string"
            },
            "rootThreadId": {
              "type": "string"
            },
            "parentWorkspaceId": {
              "type": "string"
            },
            "place": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "copy": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "base": {
                  "type": "string"
                },
                "branch": {
                  "type": "string"
                },
                "carried": {
                  "type": "string",
                  "enum": [
                    "deps-and-config",
                    "config-only",
                    "nothing"
                  ]
                },
                "fellBack": {
                  "type": "string"
                },
                "road": {
                  "type": "string",
                  "enum": [
                    "clonefile",
                    "worktree"
                  ]
                },
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "base",
                "branch",
                "carried",
                "road",
                "source"
              ],
              "additionalProperties": false
            },
            "portBase": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "id",
            "name",
            "machineId",
            "phase",
            "golden",
            "createdAt",
            "project"
          ],
          "additionalProperties": false
        },
        "notice": {
          "type": "string"
        }
      },
      "required": [
        "workspace"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
