{
  "cloudOff": {
    "name": "projects",
    "description": "Every project this host holds: its name, the computer it lives on, where its code comes from (a folder on the computer the app runs on, or a repo a computer clones), where its folder sits, the branch a machine of it starts on, and its repo's top folder where it is a folder here inside a git repo. The name is what run takes. A project is recorded with add and is one source on one computer; on the computer the app runs on its threads run in its folder, or in a worktree of its repo for another branch. defaults holds, by project id, the agent, model, effort and access a new thread there starts on when its start names none, each with where it came from: the project's own (projects_set), the person's default (agents_set, agents_default) or the agent's own.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "computer": {
                "type": "string"
              },
              "source": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "folder"
                      },
                      "path": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "path"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "git"
                      },
                      "url": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "url"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "github"
                      },
                      "repo": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "repo"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "gitlab"
                      },
                      "repo": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "repo"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "path": {
                "type": "string"
              },
              "remote": {
                "type": "string"
              },
              "defaultBranch": {
                "type": "string"
              },
              "memoryKey": {
                "type": "string"
              },
              "memoryDir": {
                "type": "string"
              },
              "checkout": {
                "type": "string"
              },
              "seeded": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "integer"
                  },
                  "bytes": {
                    "type": "integer"
                  },
                  "memory": {
                    "type": "string",
                    "enum": [
                      "landed",
                      "kept",
                      "none"
                    ]
                  },
                  "memoryFiles": {
                    "type": "integer"
                  },
                  "commits": {
                    "type": "integer"
                  },
                  "at": {
                    "type": "string"
                  }
                },
                "required": [
                  "files",
                  "bytes",
                  "memory",
                  "commits",
                  "at"
                ],
                "additionalProperties": false
              },
              "installed": {
                "type": "object",
                "properties": {
                  "row": {
                    "type": "string"
                  },
                  "command": {
                    "type": "string"
                  },
                  "at": {
                    "type": "string"
                  },
                  "seconds": {
                    "type": "number"
                  }
                },
                "required": [
                  "row",
                  "command",
                  "at",
                  "seconds"
                ],
                "additionalProperties": false
              },
              "image": {
                "type": "object",
                "properties": {
                  "snapshotId": {
                    "type": "string"
                  },
                  "builtAt": {
                    "type": "string"
                  },
                  "lockfileSha": {
                    "type": "string"
                  }
                },
                "required": [
                  "snapshotId",
                  "builtAt"
                ],
                "additionalProperties": false
              },
              "base": {
                "type": "string"
              },
              "git": {
                "type": "object",
                "properties": {
                  "top": {
                    "type": "string"
                  }
                },
                "required": [
                  "top"
                ],
                "additionalProperties": false
              },
              "createdAt": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "name",
              "computer",
              "source",
              "path",
              "remote",
              "defaultBranch",
              "memoryKey",
              "memoryDir",
              "createdAt"
            ],
            "additionalProperties": false
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string",
                    "enum": [
                      "named",
                      "project",
                      "default",
                      "catalog"
                    ]
                  }
                },
                "required": [
                  "value",
                  "from"
                ],
                "additionalProperties": false
              },
              "model": {
                "$ref": "#/properties/defaults/additionalProperties/properties/agent"
              },
              "effort": {
                "$ref": "#/properties/defaults/additionalProperties/properties/agent"
              },
              "access": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "enum": [
                      "ask",
                      "auto-edit",
                      "full",
                      "plan"
                    ]
                  },
                  "mode": {
                    "type": "string"
                  },
                  "from": {
                    "$ref": "#/properties/defaults/additionalProperties/properties/agent/properties/from"
                  }
                },
                "required": [
                  "value",
                  "mode",
                  "from"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "agent"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "projects",
        "defaults"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
