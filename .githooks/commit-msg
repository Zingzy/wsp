#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
# What the reviews keep finding in a message, refused before the commit exists.
# The body is read without git's own comment lines and without the diff a
# verbose commit appends below the scissors, so neither can trip a rule. A
# grep's first hit names the line, since cutting at the first colon of the
# whole output takes the first line's number with it. A line beginning with a
# hash is read as git's own comment and skipped, which the message an editor
# writes needs; -m and -F keep such a line in the commit, so a rule's words
# written behind a hash pass, and that is accepted.
msg=""
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    "#"*">8"*) break ;;
    "#"*) continue ;;
  esac
  msg="$msg$line
"
done < "$1"

dash=$(printf '%s' "$msg" | grep -n -e '—' -e '–')
if [ -n "$dash" ]; then
  echo "refused: line ${dash%%:*} of the commit message has an em dash or an en dash; write it with a comma, a colon or two sentences" >&2
  exit 1
fi

if printf '%s' "$msg" | grep -qi '^[[:space:]]*Co-Authored-By:'; then
  echo "refused: the commit message carries a Co-Authored-By trailer; delete that line" >&2
  exit 1
fi

ticket=$(printf '%s' "$msg" | grep -nE '(^|[^[:alnum:]_])#[0-9]+([^[:alnum:]]|$)')
if [ -n "$ticket" ]; then
  echo "refused: line ${ticket%%:*} of the commit message names a ticket number; say what the commit does and leave the number on the tracker" >&2
  exit 1
fi

# Authorship, not vocabulary: this repository's registered agent is a tool, so commits about its adapter, its
# catalog row and its sign-in name it, and 134 of main's commits would fall to a rule on the bare names. What is
# refused is a line that hands the work to one of them.
tool='(claude|codex|anthropic|openai|opus|fable|sonnet|gpt|an ai|an agent)'
credit=$(printf '%s' "$msg" | grep -nEi "(generated with|generated by|co-authored|written by|with help from).*(^|[^[:alnum:]_])$tool([^[:alnum:]_]|\$)")
if [ -n "$credit" ]; then
  echo "refused: line ${credit%%:*} of the commit message credits a tool for the work; say what changed and leave authorship out" >&2
  exit 1
fi

robot=$(printf '%s' "$msg" | grep -n '🤖')
if [ -n "$robot" ]; then
  echo "refused: line ${robot%%:*} of the commit message carries the robot of a generated footer; delete that line" >&2
  exit 1
fi

# A hyphen binds a word here as a letter does, so the slug in a merge message (ticket/910-ai-summary) is one word
# and the standalone word in a sentence is not.
ai=$(printf '%s' "$msg" | grep -nEi '(^|[^[:alnum:]_-])ai([^[:alnum:]_-]|$)')
if [ -n "$ai" ]; then
  echo "refused: line ${ai%%:*} of the commit message says AI; name the thing that changed instead" >&2
  exit 1
fi

exit 0
