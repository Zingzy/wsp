{
  "$schema": "https://registry.scalar.com/@scalar/schemas/config",
  "scalar": "2.0.0",
  "info": {
    "title": "wsp docs",
    "description": "Your setup, on cloud machines, for coding agents."
  },
  "assetsDir": "assets",
  "siteConfig": {
    "logo": {
      "darkMode": "assets/logo-dark.svg",
      "lightMode": "assets/logo-light.svg"
    },
    "head": {
      "title": "wsp docs",
      "meta": [
        {
          "name": "description",
          "content": "How to put your coding-agent setup on cloud machines with wsp: install, the image, workspaces, threads, sign-ins, the MCP tools and the command line."
        }
      ],
      "styles": [
        {
          "path": "assets/custom.css",
          "tagPosition": "head"
        }
      ],
      "links": [
        {
          "rel": "icon",
          "href": "/favicon.png"
        }
      ],
      "scripts": [
        {
          "path": "assets/highlight-shell.js",
          "tagPosition": "head"
        }
      ]
    }
  },
  "navigation": {
    "header": [
      {
        "type": "link",
        "title": "GitHub",
        "align": "end",
        "to": "https://github.com/Zingzy/wsp",
        "newTab": true
      },
      {
        "type": "link",
        "title": "Install",
        "style": "button",
        "align": "end",
        "to": "/start/install"
      }
    ],
    "routes": {
      "/": {
        "type": "group",
        "title": "wsp docs",
        "mode": "flat",
        "children": {
          "/": {
            "type": "page",
            "title": "What wsp is",
            "filepath": "content/start/what-wsp-is.mdx"
          },
          "/start": {
            "type": "group",
            "title": "Start here",
            "mode": "flat",
            "children": {
              "/install": {
                "type": "page",
                "title": "Install",
                "filepath": "content/start/install.mdx"
              },
              "/first-workspace": {
                "type": "page",
                "title": "Your first workspace",
                "filepath": "content/start/first-workspace.mdx"
              },
              "/the-model": {
                "type": "page",
                "title": "The model",
                "filepath": "content/start/the-model.mdx"
              }
            }
          },
          "/setup": {
            "type": "group",
            "title": "Setup",
            "mode": "flat",
            "children": {
              "/init": {
                "type": "page",
                "title": "wsp init, screen by screen",
                "filepath": "content/setup/init.mdx"
              },
              "/recipes": {
                "type": "page",
                "title": "Recipes and the agent path",
                "filepath": "content/setup/recipes.mdx"
              },
              "/sign-ins": {
                "type": "page",
                "title": "Sign-ins and the relay",
                "filepath": "content/setup/sign-ins.mdx"
              },
