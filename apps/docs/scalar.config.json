                "title": "The host",
                "filepath": "content/setup/the-host.mdx"
              }
            }
          },
          "/work": {
            "type": "group",
            "title": "Working",
            "mode": "flat",
            "children": {
              "/workspaces": {
                "type": "page",
                "title": "Workspaces",
                "filepath": "content/work/workspaces.mdx"
              },
              "/threads": {
                "type": "page",
                "title": "Threads",
                "filepath": "content/work/threads.mdx"
              },
