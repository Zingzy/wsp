                "filepath": "content/reference/providers.mdx"
              },
              "/reach": {
                "type": "page",
                "title": "How a browser reaches a machine",
                "filepath": "content/reference/reach.mdx"
              },
              "/configuration": {
                "type": "page",
                "title": "Files, ports and state",
                "filepath": "content/reference/configuration.mdx"
              },
              "/troubleshooting": {
                "type": "page",
                "title": "Troubleshooting",
                "filepath": "content/reference/troubleshooting.mdx"
              }
            }
          },
          "/project": {
            "type": "group",
            "title": "Project",
            "mode": "flat",
            "children": {
              "/contributing": {
                "type": "page",
                "title": "Contributing",
                "filepath": "content/project/contributing.mdx"
              },
              "/releases": {
                "type": "page",
                "title": "Releases",
                "filepath": "content/project/releases.mdx"
              },
              "/license": {
