{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "allowJs": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "test", "worker", "vite.config.ts"]
}
